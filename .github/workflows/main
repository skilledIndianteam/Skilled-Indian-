name: Build Skilled Indian Provider APK

on:
  workflow_dispatch:

  push:
    branches:
      - main

permissions:
  contents: read

jobs:

  build-apk:

    name: Build Android APK

    runs-on: ubuntu-latest

    steps:

      # ============================================================
      # 1. CHECKOUT REPOSITORY
      # ============================================================

      - name: Checkout Repository
        uses: actions/checkout@v5


      # ============================================================
      # 2. SETUP NODE.JS 24
      # ============================================================

      - name: Setup Node.js 24
        uses: actions/setup-node@v5
        with:
          node-version: '24'
          package-manager-cache: false


      # ============================================================
      # 3. SETUP JAVA 21
      # ============================================================

      - name: Setup Java 21
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '21'


      # ============================================================
      # 4. SETUP ANDROID SDK
      # ============================================================

      - name: Setup Android SDK
        uses: android-actions/setup-android@v4


      # ============================================================
      # 5. DISPLAY NODE / NPM / JAVA INFORMATION
      # ============================================================

      - name: Check Build Environment
        shell: bash
        run: |

          set -e

          echo "=============================================="
          echo "BUILD ENVIRONMENT"
          echo "=============================================="

          echo ""
          echo "Node:"
          node --version

          echo ""
          echo "NPM:"
          npm --version

          echo ""
          echo "Java:"
          java -version

          echo ""
          echo "=============================================="
          echo "ANDROID"
          echo "=============================================="

          adb version || true


      # ============================================================
      # 6. CHECK REPOSITORY
      # ============================================================

      - name: Check Repository Structure
        shell: bash
        run: |

          set -e

          echo "=============================================="
          echo "REPOSITORY STRUCTURE"
          echo "=============================================="

          find . -maxdepth 5 -type f | sort

          echo ""
          echo "Repository check completed."


      # ============================================================
      # 7. CHECK WEB APPLICATION
      # ============================================================

      - name: Verify Application HTML
        shell: bash
        run: |

          set -e

          echo "=============================================="
          echo "CHECKING APPLICATION"
          echo "=============================================="

          if [ ! -f "www/index.html" ]; then

            echo ""
            echo "ERROR:"
            echo "www/index.html was not found."
            echo ""
            echo "Expected structure:"
            echo ""
            echo "www/"
            echo "  index.html"
            echo ""

            echo "Current files:"
            find . -maxdepth 5 -type f | sort

            exit 1
          fi

          echo ""
          echo "SUCCESS:"
          echo "www/index.html exists."

          echo ""
          echo "Application size:"

          du -h www/index.html


      # ============================================================
      # 8. CREATE PACKAGE.JSON
      # ============================================================

      - name: Create Package Configuration
        shell: bash
        run: |

          set -e

          cat > package.json <<'EOF'
{
  "name": "skilled-indian-provider",
  "version": "1.0.0",
  "private": true,
  "description": "Skilled Indian Provider Android Application",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cap": "cap"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/android": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
EOF

          echo "package.json created."


      # ============================================================
      # 9. CREATE CAPACITOR CONFIG
      # ============================================================

      - name: Create Capacitor Configuration
        shell: bash
        run: |

          set -e

          cat > capacitor.config.json <<'EOF'
{
  "appId": "com.skilledindian.provider",
  "appName": "Skilled Indian Provider",
  "webDir": "www"
}
EOF

          echo "capacitor.config.json created."


      # ============================================================
      # 10. INSTALL NPM DEPENDENCIES
      # ============================================================

      - name: Install Capacitor Dependencies
        shell: bash
        run: |

          set -e

          echo "=============================================="
          echo "INSTALLING CAPACITOR"
          echo "=============================================="

          npm install

          echo ""
          echo "NPM installation completed."


      # ============================================================
      # 11. CHECK CAPACITOR VERSION
      # ============================================================

      - name: Verify Capacitor
        shell: bash
        run: |

          set -e

          echo "=============================================="
          echo "CAPACITOR VERSION"
          echo "=============================================="

          npx cap --version

          echo ""
          echo "Capacitor is ready."


      # ============================================================
      # 12. CREATE ANDROID PROJECT
      # ============================================================

      - name: Create Android Project
        shell: bash
        run: |

          set -e

          echo "=============================================="
          echo "CREATING ANDROID PROJECT"
          echo "=============================================="

          if [ -d "android" ]; then

            echo "Android project already exists."
            echo "Using existing Android project."

          else

            echo "Creating Android project..."

            npx cap add android

          fi

          echo ""
          echo "Android project ready."


      # ============================================================
      # 13. SYNC APPLICATION WITH ANDROID
      # ============================================================

      - name: Sync Capacitor Application
        shell: bash
        run: |

          set -e

          echo "=============================================="
          echo "SYNCING APPLICATION"
          echo "=============================================="

          npx cap sync android

          echo ""
          echo "Application synced successfully."


      # ============================================================
      # 14. VERIFY ANDROID PROJECT
      # ============================================================

      - name: Verify Android Project
        shell: bash
        run: |

          set -e

          echo "Checking Android project..."

          if [ ! -f "android/gradlew" ]; then

            echo "ERROR: android/gradlew not found."

            exit 1

          fi

          if [ ! -d "android/app" ]; then

            echo "ERROR: android/app directory not found."

            exit 1

          fi

          if [ ! -f "android/settings.gradle" ] && \
             [ ! -f "android/settings.gradle.kts" ]; then

            echo "ERROR: Android settings file not found."

            exit 1

          fi

          echo ""
          echo "Android project verified successfully."


      # ============================================================
      # 15. MAKE GRADLE EXECUTABLE
      # ============================================================

      - name: Enable Gradle Wrapper
        shell: bash
        run: |

          set -e

          chmod +x android/gradlew

          echo "Gradle wrapper enabled."


      # ============================================================
      # 16. CHECK GRADLE VERSION
      # ============================================================

      - name: Check Gradle
        shell: bash
        working-directory: android
        run: |

          set -e

          ./gradlew --version


      # ============================================================
      # 17. ACCEPT ANDROID LICENSES
      # ============================================================

      - name: Accept Android Licenses
        shell: bash
        run: |

          set +e

          yes | sdkmanager --licenses

          exit 0


      # ============================================================
      # 18. BUILD DEBUG APK
      # ============================================================

      - name: Build Debug APK
        shell: bash
        working-directory: android
        run: |

          set -e

          echo "=============================================="
          echo "BUILDING ANDROID APK"
          echo "=============================================="

          ./gradlew assembleDebug \
            --no-daemon \
            --stacktrace \
            --warning-mode all

          echo ""
          echo "=============================================="
          echo "APK BUILD FINISHED"
          echo "=============================================="


      # ============================================================
      # 19. FIND APK
      # ============================================================

      - name: Find APK
        shell: bash
        run: |

          set -e

          echo "=============================================="
          echo "SEARCHING FOR APK"
          echo "=============================================="

          find android \
            -type f \
            -name "*.apk" \
            -print


      # ============================================================
      # 20. VERIFY APK
      # ============================================================

      - name: Verify APK
        shell: bash
        run: |

          set -e

          APK_FILE="android/app/build/outputs/apk/debug/app-debug.apk"

          if [ ! -f "$APK_FILE" ]; then

            echo ""
            echo "=============================================="
            echo "ERROR: APK WAS NOT CREATED"
            echo "=============================================="

            echo ""
            echo "Available APK files:"

            find android \
              -type f \
              -name "*.apk" \
              -print || true

            exit 1
          fi

          echo ""
          echo "=============================================="
          echo "APK SUCCESSFULLY CREATED"
          echo "=============================================="

          ls -lh "$APK_FILE"


      # ============================================================
      # 21. PREPARE FINAL APK
      # ============================================================

      - name: Prepare Final APK
        shell: bash
        run: |

          set -e

          mkdir -p apk-output

          cp \
            android/app/build/outputs/apk/debug/app-debug.apk \
            apk-output/Skilled-Indian-Provider-V18.apk

          echo ""
          echo "Final APK prepared:"

          ls -lh \
            apk-output/Skilled-Indian-Provider-V18.apk


      # ============================================================
      # 22. UPLOAD APK TO GITHUB
      # ============================================================

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: Skilled-Indian-Provider-V18-APK
          path: apk-output/Skilled-Indian-Provider-V18.apk
          if-no-files-found: error


      # ============================================================
      # 23. FINAL SUCCESS MESSAGE
      # ============================================================

      - name: Build Success
        shell: bash
        run: |

          echo ""
          echo "================================================"
          echo "       SKILLED INDIAN PROVIDER APK"
          echo "================================================"

          echo ""
          echo "BUILD STATUS: SUCCESS"

          echo ""
          echo "APK FILE:"
          echo "Skilled-Indian-Provider-V18.apk"

          echo ""
          echo "DOWNLOAD LOCATION:"
          echo "GitHub Actions > Artifacts"

          echo ""
          echo "================================================"
