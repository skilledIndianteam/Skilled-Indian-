name: Build Skilled Indian Provider APK

on:
  push:
    branches:
      - main

  workflow_dispatch:

permissions:
  contents: read

jobs:
  build-apk:

    name: Build Android APK
    runs-on: ubuntu-latest

    steps:

      # ============================================================
      # 1. DOWNLOAD YOUR GITHUB REPOSITORY
      # ============================================================

      - name: Checkout Repository
        uses: actions/checkout@v4


      # ============================================================
      # 2. INSTALL NODE.JS
      # ============================================================

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22


      # ============================================================
      # 3. INSTALL JAVA 21
      # ============================================================

      - name: Setup Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'


      # ============================================================
      # 4. INSTALL ANDROID SDK
      # ============================================================

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3


      # ============================================================
      # 5. CREATE CLEAN WEB APP DIRECTORY
      #
      # YOUR ZIP STRUCTURE:
      #
      # skilled-indian-provider-complete-final-v18/
      # └── index.html
      #
      # We copy that index.html into www/
      # ============================================================

      - name: Prepare Web Application
        shell: bash
        run: |

          set -e

          echo "======================================"
          echo "Preparing Skilled Indian Provider"
          echo "======================================"

          mkdir -p www

          if [ -f "skilled-indian-provider-complete-final-v18/index.html" ]; then

            echo "Found application index.html"

            cp "skilled-indian-provider-complete-final-v18/index.html" \
               "www/index.html"

          elif [ -f "index.html" ]; then

            echo "Found root index.html"

            cp "index.html" "www/index.html"

          else

            echo "ERROR: index.html was not found."
            echo ""
            echo "Repository files:"
            find . -maxdepth 3 -type f | sort

            exit 1

          fi

          echo ""
          echo "Web application prepared:"
          ls -lh www/index.html


      # ============================================================
      # 6. CREATE PACKAGE.JSON
      # ============================================================

      - name: Create Node Project
        shell: bash
        run: |

          set -e

          cat > package.json <<'EOF'
          {
            "name": "skilled-indian-provider",
            "version": "1.0.0",
            "private": true,
            "description": "Skilled Indian Provider Android Application",
            "scripts": {
              "android": "cap run android"
            },
            "dependencies": {
              "@capacitor/core": "^8.5.2",
              "@capacitor/android": "^8.5.2"
            },
            "devDependencies": {
              "@capacitor/cli": "^8.5.2"
            }
          }
          EOF

          echo "package.json created."


      # ============================================================
      # 7. INSTALL CAPACITOR
      # ============================================================

      - name: Install Capacitor
        shell: bash
        run: |

          set -e

          npm install

          echo ""
          echo "Capacitor installed successfully."


      # ============================================================
      # 8. CREATE CAPACITOR CONFIGURATION
      # ============================================================

      - name: Create Capacitor Configuration
        shell: bash
        run: |

          set -e

          cat > capacitor.config.json <<'EOF'
          {
            "appId": "com.skilledindian.provider",
            "appName": "Skilled Indian Provider",
            "webDir": "www",
            "bundledWebRuntime": false
          }
          EOF

          echo "Capacitor configuration created."


      # ============================================================
      # 9. CREATE ANDROID PROJECT
      # ============================================================

      - name: Add Android Platform
        shell: bash
        run: |

          set -e

          npx cap add android

          echo ""
          echo "Android project created."


      # ============================================================
      # 10. SYNC WEB APPLICATION INTO ANDROID
      # ============================================================

      - name: Sync Application
        shell: bash
        run: |

          set -e

          npx cap sync android

          echo ""
          echo "Web application synced with Android."


      # ============================================================
      # 11. SET APPLICATION VERSION
      # ============================================================

      - name: Configure Android Application
        shell: bash
        run: |

          set -e

          echo "Configuring Android application..."

          APP_GRADLE="android/app/build.gradle"

          if [ -f "$APP_GRADLE" ]; then

            python3 - <<'PY'
          from pathlib import Path

          p = Path("android/app/build.gradle")
          text = p.read_text()

          text = text.replace(
              'versionCode 1',
              'versionCode 1'
          )

          text = text.replace(
              'versionName "1.0"',
              'versionName "1.0.0"'
          )

          p.write_text(text)
          PY

          fi

          echo "Android application configured."


      # ============================================================
      # 12. MAKE GRADLE EXECUTABLE
      # ============================================================

      - name: Grant Gradle Permission
        shell: bash
        run: |

          set -e

          chmod +x android/gradlew


      # ============================================================
      # 13. ACCEPT ANDROID LICENSES
      # ============================================================

      - name: Accept Android Licenses
        shell: bash
        run: |

          yes | sdkmanager --licenses > /dev/null || true


      # ============================================================
      # 14. BUILD DEBUG APK
      #
      # DEBUG APK IS INSTALLABLE ON ANDROID PHONE.
      # ============================================================

      - name: Build Debug APK
        shell: bash
        working-directory: android
        run: |

          set -e

          echo "======================================"
          echo "Building APK..."
          echo "======================================"

          ./gradlew assembleDebug \
            --no-daemon \
            --stacktrace

          echo ""
          echo "APK BUILD FINISHED."


      # ============================================================
      # 15. CHECK APK
      # ============================================================

      - name: Verify APK
        shell: bash
        run: |

          set -e

          echo "Searching for APK..."

          find android/app/build/outputs/apk \
            -type f \
            -name "*.apk" \
            -print

          if [ ! -f "android/app/build/outputs/apk/debug/app-debug.apk" ]; then

            echo ""
            echo "ERROR: APK was not generated."

            exit 1

          fi

          echo ""
          echo "APK successfully generated."

          ls -lh \
            android/app/build/outputs/apk/debug/app-debug.apk


      # ============================================================
      # 16. CREATE OUTPUT DIRECTORY
      # ============================================================

      - name: Prepare APK File
        shell: bash
        run: |

          set -e

          mkdir -p apk-output

          cp \
            android/app/build/outputs/apk/debug/app-debug.apk \
            apk-output/Skilled-Indian-Provider-V18.apk

          echo "Final APK:"
          ls -lh apk-output/


      # ============================================================
      # 17. UPLOAD APK TO GITHUB
      # ============================================================

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Skilled-Indian-Provider-V18-APK
          path: apk-output/Skilled-Indian-Provider-V18.apk
          if-no-files-found: error
